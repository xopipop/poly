# ============================================================
# Polymarket Trading Bot — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control!
# ============================================================

# --- Wallet ---
# Your EVM private key (hex, without 0x prefix).
# Used for L1 EIP-712 signing and deriving API credentials.
PRIVATE_KEY=your_private_key_here

# --- Polymarket ---
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# --- News API (https://newsapi.org) ---
NEWS_API_KEY=your_newsapi_key_here

# --- Risk Management ---
MAX_RISK_PCT=0.02
EDGE_THRESHOLD=0.10
KELLY_MULTIPLIER=0.25
POLYGON_FEE=0.0002

# --- Gamma API (Polymarket market data) ---
GAMMA_API_URL=https://gamma-api.polymarket.com

# --- Polygon RPC (for balance checks) ---
POLYGON_RPC_URL=https://polygon-rpc.com

# --- USDC on Polygon ---
USDC_CONTRACT=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
